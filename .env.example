# OpenAI API Key for live eval (leave blank or invalid to use built-in mock mode)
OPENAI_API_KEY=

# Model to use for feature under test
DEFAULT_MODEL=gpt-4o-mini

# Slack Webhook URL for alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Thresholds for alert levels (percentage points drop)
WARNING_THRESHOLD_PCT=3.0
CRITICAL_THRESHOLD_PCT=8.0
